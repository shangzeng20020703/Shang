ENVIRONMENT=development
DATABASE_BACKEND=sqlite
# Production requires an explicit secret (at least 32 random characters).
# SECRET_KEY=
# Optional Tencent Web Service key; GPS rules use Tencent/GCJ-02 coordinates.
# TENCENT_MAP_WEB_SERVICE_KEY=
# Optional browser map fallback. Admin API settings override it; restrict the Key to your actual Web domains.
# TENCENT_MAP_BROWSER_KEY=
# To use MySQL:
# DATABASE_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=aftersales
# MYSQL_PASSWORD=
# MYSQL_DB=aftersales_attendance

# Phone/password uses the roster. Optional wecom_only requires complete WeCom settings.
LOGIN_MODE=password
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_WEB_REDIRECT_URI=
WECHAT_MOBILE_REDIRECT_URI=
# First production administrator: supply ADMIN_PHONE, ADMIN_PASSWORD and ADMIN_WECOM_USERID
# in the bootstrap process environment; never commit live credentials.

# Tegene PMS read integration. Use an existing principal with pms:project:read
# and the intended ALL-project data scope. Secrets stay in backend/.env only.
TEGENE_API_BASE_URL=
# Example API base: https://i.tegene.com/api
# Preferred: existing Logto machine-to-machine application credentials.
TEGENE_TOKEN_URL=
TEGENE_CLIENT_ID=
TEGENE_CLIENT_SECRET=
TEGENE_RESOURCE=
TEGENE_SCOPE=
# Alternative for short-lived validation; expires with the upstream token.
TEGENE_ACCESS_TOKEN=
