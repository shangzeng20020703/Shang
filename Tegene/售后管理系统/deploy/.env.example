MYSQL_PASSWORD=replace-with-random-db-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TENCENT_MAP_WEB_SERVICE_KEY=
TENCENT_MAP_BROWSER_KEY=
LOGIN_MODE=password
RELEASE_TAG=local
ALLOWED_ORIGINS=["https://sh.tegene.com"]

# Read-only Tegene project integration; production credentials stay on the server.
TEGENE_API_BASE_URL=
TEGENE_TOKEN_URL=
TEGENE_CLIENT_ID=
TEGENE_CLIENT_SECRET=
TEGENE_RESOURCE=
TEGENE_SCOPE=

# Phone/password uses the roster. Optional wecom_only requires complete WeCom settings.
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_WEB_REDIRECT_URI=
WECHAT_MOBILE_REDIRECT_URI=
# First administrator: supply ADMIN_PHONE and ADMIN_PASSWORD; optional ADMIN_WECOM_USERID
# in the bootstrap process environment; never commit live credentials.
